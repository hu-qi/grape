diff --git a/test/test_gitlab_transport.py b/test/test_gitlab_transport.py
new file mode 100644
index 0000000..6a660f7
--- /dev/null
+++ b/test/test_gitlab_transport.py
@@ -0,0 +1,45 @@
+import subprocess
+from src.commands import git as git_mod
+
+
+def test_private_nested_repository_is_detected():
+    assert git_mod._repo_from_url('https://gitlab.example/group/sub/project.git') == 'group/sub/project'
+
+
+def test_scoped_header_is_not_sent_to_other_hosts_or_projects(monkeypatch):
+    class Api:
+        def request(self, method, path):
+            assert path == '/api/repos/group/sub/project/git-credential'
+            return 200, {'username': 'oauth2', 'password': 'test-only-secret',
+                         'clone_url': 'https://gitlab.example/group/sub/project.git'}
+    monkeypatch.setattr(git_mod, 'ApiClient', Api)
+    import os
+    env = os.environ.copy()
+    git_mod._inject_git_credentials('group/sub/project', env)
+    allowed = subprocess.run(['git', 'config', '--get-urlmatch', 'http.extraheader',
+                              'https://gitlab.example/group/sub/project.git/info/refs'], env=env, capture_output=True)
+    assert allowed.returncode == 0
+    for url in ['https://evil.example/group/sub/project.git',
+                'https://gitlab.example/group/sub/other.git',
+                'http://gitlab.example/group/sub/project.git']:
+        denied = subprocess.run(['git', 'config', '--get-urlmatch', 'http.extraheader', url], env=env, capture_output=True)
+        assert denied.returncode != 0
+        assert not denied.stdout
+
+
+def test_credential_url_must_match_the_requested_repository(monkeypatch):
+    import pytest
+    from src.client import CliError
+    class Api:
+        def request(self, method, path):
+            return 200, {'username': 'oauth2', 'password': 'test-only-secret',
+                         'clone_url': 'https://gitlab.example/other/project.git'}
+    monkeypatch.setattr(git_mod, 'ApiClient', Api)
+    env = {}
+    with pytest.raises(CliError, match='invalid credential repository URL'):
+        git_mod._inject_git_credentials('group/project', env)
+    assert 'GIT_CONFIG_COUNT' not in env
+
+
+def test_url_with_encoded_parent_component_is_rejected():
+    assert git_mod._repo_from_url('https://gitlab.example/group/%2e%2e/project.git') == ''
